{
  "name": "boopl-language",
  "displayName": "Boopl Language",
  "description": "Поддержка языка Boopl (синтаксис, подсветка)",
  "version": "0.1.0",
  "publisher": "boopl",
  "repository": {
    "type": "git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": ["boopl"],
  "contributes": {
    "languages": [{
      "id": "boopl",
      "aliases": ["Boopl", "boopl"],
      "extensions": [".bpl", ".boopl", ".bp"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "boopl",
      "scopeName": "source.boopl",
      "path": "./syntaxes/boopl.tmLanguage.json"
    }],
    "snippets": [{
      "language": "boopl",
      "path": "./snippets/snippets.json"
    }]
  }
}