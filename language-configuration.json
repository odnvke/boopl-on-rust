{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    {"open": "'", "close": "'", "notIn": ["string", "comment"]},
    {"open": "\"", "close": "\"", "notIn": ["string", "comment"]},
    {"open": "(", "close": ")", "notIn": ["string", "comment"]},
    {"open": "[", "close": "]", "notIn": ["string", "comment"]},
    {"open": "{", "close": "}", "notIn": ["string", "comment"]}
  ],
  "surroundingPairs": [
    ["'", "'"],
    ["\"", "\""],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^(.*\\b(I|IF)\\b.*|.*\\{.*)$",
    "decreaseIndentPattern": "^\\s*(E|END|\\}).*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#region\\b",
      "end": "^\\s*//\\s*#endregion\\b"
    }
  },
  "wordPattern": "[a-zA-Zа-яА-Я_][a-zA-Zа-яА-Я0-9_]*"
}