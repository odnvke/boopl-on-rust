{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Boopl",
  "scopeName": "source.boopl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "match": "\\b(?:[a-zA-Zа-яА-Я_][a-zA-Zа-яА-Я0-9_]*|[0-9]+)\\b",
      "name": "variable.other.boopl"
    },
    {
      "include": "#pointers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.double-slash.boopl",
        "match": "//.*$"
      },
      {
        "name": "comment.block.boopl",
        "begin": "/\\*",
        "end": "\\*/"
      }]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.boopl",
        "match": "\\b(I|IG|E|G|IN|IMPORT)\\b"
      },
      {
        "name": "keyword.output.boopl",
        "match": "\\bP\\b"
      },
      {
        "name": "keyword.special.boopl",
        "match": "\\b(N|S|U)\\b"
      }]
    },
    "operators": {
      "patterns": [{
        "name": "keyword.operator.boopl",
        "match": "\\b(O|A|X)\\b"
      }]
    },
    "pointers": {
      "patterns": [{
        "name": "entity.name.label.pointer.boopl",
        "match": "P\\.\\s*(\\S+)"
      },
      {
        "name": "entity.name.label.dynamic-pointer.boopl",
        "match": "PD\\.\\s*(\\S+)"
      }]
    },
    "booleans": {
      "patterns": [{
        "name": "constant.language.boolean.true.boopl",
        "match": "\\bT\\b"
      },
      {
        "name": "constant.language.boolean.false.boopl",
        "match": "\\bF\\b"
      }]
    },
    "punctuation": {
      "patterns": [{
        "name": "punctuation.terminator.boopl",
        "match": ";"
      }]
    }
  }
}